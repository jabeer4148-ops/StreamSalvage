# ---- Desktop app build (optional) ----
# Embedded at COMPILE TIME via src-tauri/build.rs. Leave unset to use the default
# https://streamsalvage.com/api/validate-license. No payment secrets go into the app.
# Debug builds with this unset accept any license key starting with TEST-.
# STREAMSALVAGE_LICENSE_API_URL=https://streamsalvage.com/api/validate-license

# ---- Landing site API (Vercel project env vars, not the app build) ----
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# BREVO_API_KEY=
